{
  "agent_config": {
    "agent_name": "Riya - Northwind support",
    "agent_type": "other",
    "agent_welcome_message": "Hi, this is Riya from Northwind Home. How can I help you today?",
    "tasks": [
      {
        "task_type": "conversation",
        "toolchain": {
          "execution": "parallel",
          "pipelines": [
            [
              "transcriber",
              "llm",
              "synthesizer"
            ]
          ]
        },
        "tools_config": {
          "input": {
            "provider": "twilio",
            "format": "wav"
          },
          "output": {
            "provider": "twilio",
            "format": "wav"
          },
          "transcriber": {
            "provider": "elevenlabs",
            "model": "scribe_v2_realtime",
            "language": "en",
            "stream": true,
            "encoding": "mulaw",
            "sampling_rate": 8000,
            "endpointing": 300,
            "min_silence_duration_ms": 150,
            "vad_threshold": 0.4
          },
          "llm_agent": {
            "agent_type": "simple_llm_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "groq",
              "model": "groq/openai/gpt-oss-120b",
              "max_tokens": 400,
              "temperature": 0.3,
              "agent_flow_type": "streaming"
            }
          },
          "synthesizer": {
            "provider": "elevenlabs",
            "provider_config": {
              "voice": "George",
              "voice_id": "VoiceIdFromAnotherAccount00",
              "model": "eleven_flash_v2_5"
            },
            "stream": true,
            "buffer_size": 100,
            "audio_format": "wav"
          },
          "api_tools": null
        },
        "task_config": {
          "hangup_after_silence": 10,
          "call_terminate": 90,
          "check_if_user_online": true,
          "trigger_user_online_message_after": 10,
          "check_user_online_message": "Are you still there?",
          "incremental_delay": 100,
          "number_of_words_for_interruption": 2,
          "optimize_latency": true,
          "backchanneling": false,
          "ambient_noise": false,
          "hangup_after_LLMCall": false
        }
      }
    ]
  },
  "agent_prompts": {
    "task_1": {
      "system_prompt": "You are Riya, a friendly phone support agent for Northwind Home, an online furniture store.\nYou are on a live phone call, so:\n- answer in one or two short sentences, in plain spoken English, no lists, no markdown;\n- ask one question at a time;\n- if the caller gives an order number, confirm it back digit by digit.\nOrder 4 8 2 1 7 shipped yesterday and arrives Thursday between 9am and 1pm. Delivery can be moved to\nFriday or Saturday. Returns are free within 30 days.\nYou have no tools or functions. Never call a function or tool; answer directly from the facts above."
    }
  }
}