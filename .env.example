# Copy this file to ".env" (same folder) and paste your keys after the "=" signs.
# Keys stay on this PC. Never commit .env. Rotate the keys after recording the demo.

# Speech-to-text - https://console.deepgram.com  (API Keys -> Create a New API Key)
DEEPGRAM_AUTH_TOKEN=

# Text-to-speech - https://elevenlabs.io/app/settings/api-keys  (enable "Text to Speech" permission)
ELEVENLABS_API_KEY=

# LLM - fill ONE of these
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional - only for the real phone-call proof clip
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MY_PHONE_NUMBER=

# Optional - to show the same settings in hosted Bolna
BOLNA_API_KEY=
